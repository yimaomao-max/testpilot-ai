{
  "manifest_version": 3,
  "name": "TestPilot Recorder",
  "version": "0.1.0",
  "description": "录制浏览器操作，一键生成 TestPilot AI 测试用例（默认 http://localhost:3000，可在插件内配置）",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://localhost:3000/*", "http://localhost:3100/*", "http://127.0.0.1:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TestPilot 录制器"
  },
  "background": {
    "service_worker": "background.js"
  }
}
